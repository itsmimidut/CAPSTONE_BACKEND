# Online reservations hold inventory for this many minutes while unpaid.
BOOKING_PAYMENT_HOLD_MINUTES=30
# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT COMMIT THE .env FILE!

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=eduardos

# Google Gemini AI API Key
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Grok AI from xAI (Get your key from: https://console.x.ai)
GROK_API_KEY=your-grok-api-key-here

# Mistral AI (Get your key from: https://console.mistral.ai)
MISTRAL_API_KEY=your-mistral-api-key-here

# Groq AI with Llama (FAST & FREE!)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional: OpenAI API Key (if you want to use OpenAI instead)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key-here

# Server Configuration
PORT=8000

# Auth / JWT
# Use a long random value in production
JWT_SECRET=your-jwt-secret-here

# Google Sign-In (OAuth 2.0 Web Client ID)
# Example format: 1234567890-abcxyz.apps.googleusercontent.com
# GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Xendit Payment Gateway
# Get your keys from: https://dashboard.xendit.co/settings/developers#api-keys
# Sign up: https://dashboard.xendit.co/register
# Test mode key starts with: xnd_development_
# Live mode key starts with: xnd_production_
XENDIT_SECRET_KEY=xnd_development_YOUR_SECRET_KEY_HERE
XENDIT_WEBHOOK_TOKEN=your_webhook_verification_token_here
FRONTEND_URL=http://localhost:5173

# Logging (Sprint 4)
LOG_LEVEL=info

# Thermal Printer Daemon (auto-starts with npm start / node server.js)
# Set to true only if you want to run printer-service.js manually
DISABLE_PRINTER_DAEMON=false
PRINTER_NAME=POS-582
PRINT_CHECK_INTERVAL_MS=120
PRINT_WATCH_DEBOUNCE_MS=25
PRINT_USE_RAW_WORKER=true
# Organization-scoped bootstrap secret used only for first-time Print Connector registration.
# Provision this securely with the connector installer; do not expose it in the admin UI.
PRINT_CONNECTOR_REGISTRATION_CREDENTIAL=replace-with-a-long-random-secret
